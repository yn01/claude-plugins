{
  "mode": "shadow",
  "model": "jev-1.13.0",
  "endpoint": "https://api.typesafe.ai/v1/systemone",
  "timeoutMs": 2000,
  "gates": {
    "completion": {
      "enabled": true,
      "thresholds": {
        "claimsDone": 0.5,
        "claimsVerified": 0.5,
        "blockedOnUser": 0.5,
        "minConfidence": 0.7
      },
      "earlyStop": {
        "enabled": true,
        "action": "notify"
      },
      "verificationCommands": [],
      "excludeAgentTypes": ["Explore", "Plan"],
      "maxBlocksPerSession": 2,
      "stateBudget": {
        "finalMessageChars": 4000,
        "maxCommands": 8,
        "perCommandOutputChars": 1500
      }
    }
  }
}
