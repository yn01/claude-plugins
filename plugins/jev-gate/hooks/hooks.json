{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/health.mjs\"",
            "timeout": 5
          }
        ],
        "description": "Health check \u2014 send one small Jev request and record whether the API key works, for /jev-gate:doctor"
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gates/completion.mjs\"",
            "timeout": 10
          }
        ],
        "description": "Evidence gate \u2014 check a completed task's claim against the verification runs in the session"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gates/completion.mjs\"",
            "timeout": 10
          }
        ],
        "description": "Evidence gate \u2014 same check when a subagent stops"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gates/completion.mjs\"",
            "timeout": 10
          }
        ],
        "description": "Evidence gate \u2014 same check when the main session stops"
      }
    ]
  }
}
